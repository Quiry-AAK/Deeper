{
  "enabledMcpjsonServers": ["unity-editor-mcp"],
  "env": {
    "UNITY_PROJECT_PATH": ".",
    "UNITY_NON_INTERACTIVE": "1",
    "UNITY_NO_PAGER": "1",
    "UNITY_NO_BANNER": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__pixellab__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/pixellab-budget.mjs\"",
            "statusMessage": "Checking PixelLab budget",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/update-skill-index.mjs\"",
            "statusMessage": "Updating skill index",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
